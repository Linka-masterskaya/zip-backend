# Local-development template only. Every credential below is an explicit DEV fixture.
# Production values are supplied by the deployment environment and are validated at startup.

# Application
APP_ENV=dev
APP_PORT=8080
APP_PUBLIC_URL=
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
CONFIG_PATH=config/config.dev.yml

# PostgreSQL (application + container)
DB_URL=postgres://linka:linka@localhost:5432/linka?sslmode=disable
POSTGRES_USER=linka
POSTGRES_PASSWORD=linka
POSTGRES_DB=linka

# Redis (production compose requires authentication)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=pass

# NATS
NATS_CONNECTION_URL=nats://localhost:4222

# MinIO — DEV ONLY fixtures
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=linka-dev-minio
MINIO_SECRET_KEY=linka-dev-minio-secret
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_TIMEOUT=15s

# JWT — DEV ONLY fixture
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Email encryption and deterministic lookup — DEV ONLY fixtures
CRYPTO_AES_KEY=ZGV2LW9ubHktYWVzLWtleS1ub3QtZm9yLXByb2QhISE=
CRYPTO_HMAC_KEY=ZGV2LW9ubHktaG1hYy1rZXktbm90LWZvci1wcm9kISE=

# Yandex OAuth2 (optional until the integration is enabled)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=

# OpenAI (optional until the integration is enabled)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=

# Pictures Bank — used only when feature_flags.local_bank=false.
# It may be empty when the local PostgreSQL + MinIO adapter is enabled.
PICTURES_BANK_URL=https://pictures.linka.su

# SMTP / Mailpit local fixture
SMTP_HOST=mailpit
SMTP_PORT=
SMTP_USERNAME=linka-dev@example.test
SMTP_PASSWORD=dev-only-smtp-password
SMTP_FROM_EMAIL=linka-dev@example.test
SMTP_TLS=
SMTP_TIMEOUT=10s
SMTP_REQUIRE_FROM_MATCH=true
SMTP_DAILY_LIMIT_ALERT=300


# Pack share email worker
PACK_SHARE_WORKERS=2
PACK_SHARE_POLL_INTERVAL=500ms
PACK_SHARE_JOB_TIMEOUT=10m
PACK_SHARE_DAILY_SENDS_PER_USER=10
PACK_SHARE_DAILY_BYTES_PER_USER=104857600
PACK_SHARE_MAX_ATTACHMENT_BYTES=15728640
PACK_SHARE_SEND_RETRIES=3
PACK_SHARE_SEND_TIMEOUT=30s
PACK_SHARE_RETRY_BACKOFF=2s
PACK_SHARE_SHUTDOWN_TIMEOUT=3m

# Authentication
AUTH_RESET_PASSWORD_TOKEN_TTL=1h
AUTH_BCRYPT_COST=12
AUTH_REFRESH_RATE_LIMIT=10

# Grafana — DEV ONLY fixture
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-admin
GRAFANA_ROOT_URL=http://localhost:3000

# Caddy
CADDY_LETSENCRYPT_EMAIL=devnull@example.test
CADDY_DOMAIN_NAME=localhost

# Deployment image
VERSION=latest

# TTS API
TTSAPI_SERVICE_URL=https://tts.linka.su
