{
  "info": {
    "_postman_id": "905bff72-d6f9-4df5-b66e-c34857e4018d",
    "name": "Linka Backend — Local",
    "description": "Локальная smoke/auth-коллекция. Выберите окружение Linka Local и запускайте запросы сверху вниз. Postman сам хранит refresh_token из Set-Cookie; login/refresh сохраняют accessToken. В текущей реализации 2026-07-31 маршрут регистрации отсутствует и первый auth-запрос ожидаемо сигнализирует об этом.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{metricsUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('status=ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Readiness (all dependencies)",
          "request": { "method": "GET", "url": "{{metricsUrl}}/readyz" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('all dependencies are ready', () => {", "  const body = pm.response.json();", "  pm.expect(body.status).to.eql('ok');", "  Object.values(body.checks).forEach(check => pm.expect(check.status).to.eql('ok'));", "});"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "01 — Authentication",
      "item": [
        {
          "name": "Register (currently missing — returns 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/register",
            "description": "Маршрут заявлен в docs/api/openapi.yaml, но не зарегистрирован в cmd/server/main.go. После реализации замените тест 404 на 201 и сохраняйте access_token так же, как в Login."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Known gap: endpoint is not implemented', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verifyToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/verify-email",
            "description": "Вставьте 43-символьный токен из verify-письма в переменную verifyToken. При auth.require_email_verification=false этот шаг для login не обязателен."
          }
        },
        {
          "name": "Login (saves access token and refresh cookie)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) {", "  const body = pm.response.json();", "  pm.expect(body.access_token).to.be.a('string').and.not.empty;", "  pm.environment.set('accessToken', body.access_token);", "}", "pm.test('refresh cookie received', () => pm.expect(pm.cookies.has('refresh_token')).to.be.true);"], "type": "text/javascript" } }]
        },
        {
          "name": "Refresh (rotates cookie and access token)",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh", "description": "Postman отправит HttpOnly refresh_token из cookie jar автоматически." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.environment.set('accessToken', pm.response.json().access_token);", "pm.test('rotated refresh cookie received', () => pm.expect(pm.cookies.has('refresh_token')).to.be.true);"], "type": "text/javascript" } }]
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/auth/verify-email/resend"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/auth/password/forgot",
            "description": "Всегда отвечает 202. Локальная конфигурация сейчас указывает на внешний SMTP, а не Mailpit."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"new_password\": \"{{newPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/password/reset"
          }
        }
      ]
    },
    {
      "name": "02 — Authenticated smoke",
      "item": [
        {
          "name": "My profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }], "url": "{{baseUrl}}/profile/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "List folders",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }], "url": "{{baseUrl}}/folders?section=my" }
        },
        {
          "name": "List packs",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }], "url": "{{baseUrl}}/packs?folder_id={{folderId}}" }
        },
        {
          "name": "List students",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }], "url": "{{baseUrl}}/students" }
        }
      ]
    },
    {
      "name": "03 — Folder + picture from Pictures Bank",
      "description": "Запускайте после Login строго сверху вниз. Папка содержит pack, а config ссылается на Pictures Bank только через source_picture_id — без копии в MinIO.",
      "item": [
        {
          "name": "1. Create folder (saves folderId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"parent_id\": null,\n  \"section\": \"my\",\n  \"kind\": \"folder\",\n  \"student_id\": null,\n  \"name\": \"Postman — картинки\"\n}" },
            "url": "{{baseUrl}}/folders"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('folderId', pm.response.json().id);"], "type": "text/javascript" } }]
        },
        {
          "name": "2. Search Pictures Bank (saves pictureId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/pictures/search?query={{pictureQuery}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) {", "  const pictures = pm.response.json();", "  const selected = pictures.find(p => (p.mimeType || '').startsWith('image/')) || pictures[0];", "  pm.expect(selected, 'Pictures Bank search result').to.exist;", "  if (selected) pm.environment.set('pictureId', selected.id);", "}"], "type": "text/javascript" } }]
        },
        {
          "name": "3. Create picture reference (no MinIO copy)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/pictures/{{pictureId}}/import"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "pm.test('reference uses selected UUID', () => pm.expect(pm.response.json().source_picture_id).to.eql(pm.environment.get('pictureId')));", "pm.test('no local media was created', () => pm.expect(pm.response.json()).not.to.have.property('media_id'));"], "type": "text/javascript" } }]
        },
        {
          "name": "4. Create pack in folder (saves packId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Набор с картинкой\",\n  \"folder_id\": \"{{folderId}}\"\n}" },
            "url": "{{baseUrl}}/packs"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('packId', pm.response.json().id);"], "type": "text/javascript" } }]
        },
        {
          "name": "5. Put source picture reference into pack config",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"metadata\": {\"version\": \"2.0\", \"title\": \"Набор с картинкой\"},\n  \"settings\": {\"columns\": 1, \"rows\": 1},\n  \"blocks\": [{\n    \"id\": \"block-1\",\n    \"type\": \"grid\",\n    \"elements\": [{\n      \"id\": \"image-1\",\n      \"kind\": \"image\",\n      \"source_picture_id\": \"{{pictureId}}\"\n    }]\n  }]\n}" },
            "url": "{{baseUrl}}/packs/{{packId}}/config"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('config stores only external reference', () => {", "  const element = pm.response.json().config.blocks[0].elements[0];", "  pm.expect(element.source_picture_id).to.eql(pm.environment.get('pictureId'));", "  pm.expect(element).not.to.have.property('media_id');", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "6. Check folder contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/folders/{{folderId}}/contents"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('folder contains created pack', () => {", "  const ids = pm.response.json().items.map(item => item.id);", "  pm.expect(ids).to.include(pm.environment.get('packId'));", "});"], "type": "text/javascript" } }]
        },
        {
          "name": "7. Get picture content (or deleted placeholder)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": "{{baseUrl}}/pictures/{{pictureId}}/content"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('image or SVG placeholder returned', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//));"], "type": "text/javascript" } }]
        }
      ]
    }
  ]
}
